# Atlas Enterprise OS — environment variables
# Copy to apps/web/.env.local and fill in real values.
# Never commit .env.local.

# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Gemini API key (server-side only, used by app/api/ai/ask)
GEMINI_API_KEY=

# Optional: Knock API key for invitation emails (server-side only).
# Without it invitations still work; email is skipped honestly.
KNOCK_API_KEY=

# Optional: show the "Continue with Google" button (build-time flag).
# Requires the Google provider configured in Supabase Auth.
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=
