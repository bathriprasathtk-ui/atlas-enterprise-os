# Atlas Enterprise OS — environment variables
# Copy to apps/web/.env.local and fill in real values.
# Never commit .env.local.

# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Gemini API key (server-side only, used by app/api/ai/ask)
GEMINI_API_KEY=
